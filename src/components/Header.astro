---
import { NAV } from '../lib/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="logo" aria-label="97 Ohm Robotics, на головну">
      <img class="logo-l" src="/brand/97ohm-logo-horizontal-light.svg" alt="97 Ohm Robotics" width="182" height="34" />
      <img class="logo-d" src="/brand/97ohm-logo-horizontal-dark.svg" alt="" width="182" height="34" />
    </a>
    <nav class="nav" aria-label="Основна навігація">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[{ cta: 'cta' in item && item.cta }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <small>{item.code}</small>
            {item.label}
          </a>
        ))
      }
      <button type="button" class="theme" id="theme-toggle" hidden>
        <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
        <span class="theme-label">АВТО</span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Перемикач теми: світла → темна → авто (за системою). Вибір зберігається в браузері.
  type Mode = 'light' | 'dark' | 'auto';
  const KEY = '97ohm-theme';
  const LABEL: Record<Mode, string> = { light: 'СВІТЛА', dark: 'ТЕМНА', auto: 'АВТО' };
  const NEXT: Record<Mode, Mode> = { light: 'dark', dark: 'auto', auto: 'light' };

  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const label = btn.querySelector('.theme-label')!;
  const media = matchMedia('(prefers-color-scheme: dark)');

  function read(): Mode {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'light' || v === 'dark' || v === 'auto') return v;
    } catch {}
    return 'auto';
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'auto') delete root.dataset.theme;
    else root.dataset.theme = mode;
    const dark = mode === 'dark' || (mode === 'auto' && media.matches);
    btn.classList.toggle('is-dark', dark);
    label.textContent = LABEL[mode];
    btn.setAttribute('aria-label', `Тема: ${LABEL[mode].toLowerCase()}. Перемкнути на: ${LABEL[NEXT[mode]].toLowerCase()}`);
  }

  let mode = read();
  apply(mode);
  btn.hidden = false;
  btn.addEventListener('click', () => {
    mode = NEXT[mode];
    try {
      localStorage.setItem(KEY, mode);
    } catch {}
    apply(mode);
  });
  media.addEventListener('change', () => apply(mode));
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--div);
    background: var(--bg);
    transition: background-color 0.3s;
  }
  .inner {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 24px;
  }
  .logo {
    display: flex;
  }
  .logo img {
    height: 34px;
    width: auto;
  }
  .logo-d {
    display: none !important;
  }
  :global(:root[data-theme='dark']) .logo-l {
    display: none !important;
  }
  :global(:root[data-theme='dark']) .logo-d {
    display: block !important;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo-l {
      display: none !important;
    }
    :global(:root:not([data-theme='light'])) .logo-d {
      display: block !important;
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .nav a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    padding: 8px 14px;
    border: 1px solid transparent;
    color: var(--fg);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.18s, border-color 0.18s;
  }
  .nav a small {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--wire);
  }
  .nav a:hover {
    border-color: var(--wire);
    color: var(--fg);
  }
  .nav a[aria-current='page'] {
    border-color: var(--wire);
    background: var(--tint);
  }
  .nav a.cta {
    margin-left: 8px;
    background: var(--yellow);
    color: var(--ink);
  }
  .nav a.cta small {
    color: var(--ink);
  }
  .nav a.cta:hover {
    background: var(--yellow-hover);
  }
  .nav a.cta[aria-current='page'] {
    border-color: var(--ink);
  }

  .theme {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    margin-left: 4px;
    padding: 0 14px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--wire);
  }
  .theme[hidden] {
    display: none;
  }
  .theme .i-moon,
  .theme.is-dark .i-sun {
    display: none;
  }
  .theme.is-dark .i-moon {
    display: block;
  }

  @media (max-width: 720px) {
    .nav {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .nav a.cta,
    .theme {
      margin-left: 0;
    }
  }
</style>
