---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import StatusTag from './StatusTag.astro';
import { projectSpan, hardwareSummary, summaryOf } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
  code: string;
  showHardware?: boolean;
}
const { project: p, code, showHardware = true } = Astro.props;
const hw = hardwareSummary(p);
---

<a href={`/projects/${p.id}/`} class="card lift" data-group={p.data.status}>
  <Photo src={p.data.cover} alt={p.data.cover_alt}>
    <span class="code mono">{code}</span>
  </Photo>
  <div class="body">
    <div class="meta">
      <span class="mono when">{projectSpan(p)}</span>
      <StatusTag status={p.data.status} />
    </div>
    <span class="title">{p.data.title}</span>
    <span class="text">{summaryOf(p)}</span>
    {showHardware && hw && <span class="mono hw">{hw}</span>}
  </div>
</a>

<style>
  .card :global(.ph) {
    border-bottom: 1px solid var(--line);
  }
  .code {
    position: absolute;
    left: 12px;
    top: 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--fg);
    background: var(--panel);
    padding: 1px 5px;
  }
  .body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 22px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .when {
    font-size: 12px;
    color: var(--wire);
  }
  .title {
    font-size: 20px;
    font-weight: 800;
  }
  .text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg2);
  }
  .hw {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--div);
    font-size: 12px;
    color: var(--wire);
    text-transform: uppercase;
  }
</style>
